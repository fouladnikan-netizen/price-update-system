# OpenAI-compatible gateway. Copy to .env and fill locally. Never commit the real key.
AI_BASE_URL=https://ai.liara.ir/api/<workspace-id>/v1
AI_MODEL=openai/gpt-5-mini
AI_API_KEY=
AI_API_PORT=8787
# 0.0.0.0 on a Linux server so the page is reachable. Keep 127.0.0.1 for local-only.
AI_API_HOST=127.0.0.1
# Built UI directory. Docker sets this. Local: leave empty and use Vite on 5173.
PRICE_UPDATE_STATIC_DIR=

# Operator login for the pricing panel. Required in production.
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=
APP_AUTH_SECRET=

# Local PostgreSQL. Do not seed products without Website product_code.
# Sources, raw intakes, and daily prices live here (ops_* tables). Missing prices stay NULL, never 0.
DATABASE_URL=postgres://price_update:price_update@127.0.0.1:5432/price_update

# Controlled Website publish API. Leave empty to keep publications queued locally.
# Never invent product_code. Missing prices stay null, never 0.
WEBSITE_API_BASE_URL=
WEBSITE_API_KEY=
WEBSITE_PUBLISH_PATH=/api/internal/price-update

# ---------------------------------------------------------------------------
# Bots — keep Bale and Telegram SEPARATE. Never put one token in the other.
# Same keys locally, in GitHub .env.example, and on production .env.
# ---------------------------------------------------------------------------

# Bale bot inbox (@nikan_price_collector_bot). Polled by the main `app` container.
# Health: cd apps/api && npm run bale:check
BALE_BOT_TOKEN=
BALE_API_BASE_URL=https://tapi.bale.ai

# Telegram bot (@price_update_nikan_bot). Runs in docker service `telegram-bot`
# (or locally: npm run telegram-bot:worker). Calls https://api.telegram.org only.
# Health: cd apps/api && npm run telegram-bot:health
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org

# Organizational Telegram user (MTProto, not the bot). Optional / paused.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Organizational Bale user (not the bot). Reads channels the org number joined.
# Run: cd apps/api && npm run bale:login
BALE_SESSION=
BALE_PHONE=
